[Unit]
Description=AutoHost Minecraft P2P daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autohost
Group=autohost
WorkingDirectory=/var/lib/autohost
ExecStart=/usr/local/bin/autohost-daemon
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/autohost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target